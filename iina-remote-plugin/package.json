{
  "name": "iina-remote-plugin",
  "version": "1.0.0",
  "source": "src/index.ts",
  "targets": {
    "plugin": {
      "distDir": "dist",
      "outputFormat": "global",
      "isLibrary": true,
      "sourceMap": false
    }
  },
  "scripts": {
    "build": "parcel build --target plugin && cp Info.json dist/",
    "watch": "parcel watch --target plugin",
    "link": "iina-plugin link dist",
    "unlink": "iina-plugin unlink dist"
  },
  "devDependencies": {
    "iina-plugin-definition": "^0.99.3",
    "parcel": "^2.16.3",
    "typescript": "^5.9.3"
  }
}
