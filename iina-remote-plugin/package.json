{
  "name": "iina-remote-plugin",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc",
    "bundle": "esbuild src/index.ts --bundle --format=iife --target=es2020 --outfile=dist/index.js",
    "build": "npm run typecheck && npm run bundle && cp ./src/public/* ./dist",
    "watch": "npm run build && npm run bundle -- --watch",
    "link": "iina-plugin link dist",
    "unlink": "iina-plugin unlink dist",
    "test": "node --test test/"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "iina-plugin-definition": "^0.99.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "qr": "^0.5.4"
  }
}
