{
  "name": "iina-remote-plugin",
  "version": "1.0.0",
  "source": "src/index.ts",
  "targets": {
    "default": {
      "distDir": "dist",
      "outputFormat": "global",
      "isLibrary": true,
      "sourceMap": false
    }
  },
  "scripts": {
    "build": "parcel build && cp ./src/public/* ./dist",
    "watch": "npm run build && parcel watch",
    "link": "iina-plugin link dist",
    "unlink": "iina-plugin unlink dist"
  },
  "devDependencies": {
    "iina-plugin-definition": "^0.99.3",
    "parcel": "^2.16.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "qr": "^0.5.4"
  }
}
